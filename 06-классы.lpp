# ==========================================================
# Пример: классы и объекты
#
# Класс — это набор функций-методов. Внутри метода «я» —
# это сам объект. Конструктор называется «создать».
# ==========================================================

класс Точка:
    функция создать(x, y):
        я.x = x
        я.y = y
    конец

    функция длина():
        вернуть корень(я.x * я.x + я.y * я.y)
    конец

    функция сдвинуть(dx, dy):
        я.x = я.x + dx
        я.y = я.y + dy
    конец

    функция показать():
        вывести("Точка(", я.x, ",", я.y, ")")
    конец
конец

т = новый Точка(3, 4)
т.показать()
вывести("расстояние до центра:", т.длина())

т.сдвинуть(1, 1)
т.показать()

# массив объектов
точки = []
для i от 1 до 3 то:
    точки.добавить(новый Точка(i, i * 2))
конец

сумма_длин = 0
для каждого p из точки то:
    p.показать()
    сумма_длин = сумма_длин + p.длина()
конец
вывести("сумма расстояний:", округ(сумма_длин, 2))
