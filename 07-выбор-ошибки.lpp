# ==========================================================
# Пример: множественный выбор и обработка ошибок
# ==========================================================

функция описать(оценка):
    выбрать оценка:
        вариант 5:
            вернуть "отлично"
        вариант 4:
            вернуть "хорошо"
        вариант 3:
            вернуть "удовлетворительно"
        вариант 1, 2:
            вернуть "плохо"
        иначе:
            вернуть "неизвестная оценка"
    конец
конец

для каждого о из [5, 4, 3, 2, 9] то:
    вывести(о, "->", описать(о))
конец

# ошибки: делим безопасно
функция делить(a, b):
    попробовать:
        вернуть a / b
    поймать ошибка:
        вывести("не вышло:", ошибка)
        вернуть 0
    конец
конец

вывести(делить(10, 2))
вывести(делить(10, 0))

# перебор строки и диапазона
буквы = ""
для каждого с из "мир" то:
    буквы = с + буквы
конец
вывести("перевёрнуто:", буквы)

вывести("чётные до 10:", диапазон(0, 10, 2))
вывести("через запятую:", соединить([1, 2, 3], ", "))
вывести("среднее:", среднее([10, 20, 30]))
