# ==========================================================
# Пример: основы L++ (переменные, условия, циклы)
# ==========================================================

вывести("Привет! Это L++")

имя = "мир"
вывести("Привет,", имя)

# числа и арифметика
а = 10
б = 3
вывести("сумма:", а + б)
вывести("деление:", а / б)
вывести("целая часть:", дел(а, б))
вывести("остаток:", а % б)
вывести("степень:", степень(2, 8))

# условие
если а > б то:
    вывести("а больше б")
иначе если а == б то:
    вывести("равны")
иначе:
    вывести("б больше а")
конец

# цикл «для»
сумма = 0
для i от 1 до 5 то:
    сумма = сумма + i
конец
вывести("сумма 1..5 =", сумма)

# цикл «пока»
n = 1
пока n < 100 то:
    n = n * 2
конец
вывести("первое число >= 100:", n)
