# ==========================================================
# Пример: аддон MixDay (математика, строки, время, сеть)
# ==========================================================

включить mixday

вывести(mixday.Версия())
вывести("сегодня:", mixday.Сегодня(), "в", mixday.Сейчас())
вывести("ОС:", mixday.ИмяОС(), "| машина:", mixday.ИмяКомпьютера())

# математика
вывести("сумма:", mixday.Сумма(1, 2, 3, 4))
вывести("среднее:", mixday.Среднее(2, 4, 6))
вывести("факториал 6:", mixday.Факториал(6))
вывести("НОД(48, 18):", mixday.НОД(48, 18))
вывести("простые до 30:", mixday.Решето(30))
вывести("это 97 простое?", mixday.ПростоеЛи(97))

# строки
вывести(mixday.СтрокаПалиндром("А роза упала на лапу Азора"))
вывести("перевёрнуто:", mixday.СтрокаПеревернуть("L++"))

# хеши
вывести("MD5:", mixday.ХешMD5("abc"))

# массивы
данные = [3, 1, 4, 1, 5, 9, 2, 6]
вывести("уникальные:", mixday.МассивУникальные(данные))
вывести("квадраты:", mixday.МассивКвадраты(данные))
вывести("только чётные:", mixday.МассивЧетные(данные))
