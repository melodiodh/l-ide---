# ==========================================================
# Пример: строки и массивы
# ==========================================================

текст = "  Привет, Мир!  "
вывести("длина:", текст.длина)
вывести("обрезано:", текст.обрезать())
вывести("верхний:", текст.обрезать().верхний())
вывести("замена:", текст.обрезать().заменить("Мир", "L++"))

слова = "яблоко,банан,вишня".разбить(",")
вывести("слова:", слова)
вывести("первое:", слова[0])
вывести("последнее:", слова[-1])

числа = [5, 3, 9, 1, 7]
числа.сортировать()
вывести("по возрастанию:", числа)
числа.перевернуть()
вывести("перевёрнуто:", числа)

# ручная сортировка пузырьком — чтобы увидеть циклы в деле
данные = [4, 8, 1, 6, 2]
n = данные.длина
для i от 0 до n - 2 то:
    для j от 0 до n - 2 - i то:
        если данные[j] > данные[j + 1] то:
            временно = данные[j]
            данные[j] = данные[j + 1]
            данные[j + 1] = временно
        конец
    конец
конец
вывести("пузырьком:", данные)

# срез и сумма
вывести("первые три:", срез(данные, 0, 3))
вывести("сумма:", сумма(данные))
