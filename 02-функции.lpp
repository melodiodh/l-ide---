# ==========================================================
# Пример: функции, рекурсия, массивы, словари
# ==========================================================

функция факториал(n):
    если n <= 1 то:
        вернуть 1
    конец
    вернуть n * факториал(n - 1)
конец

вывести("5! =", факториал(5))

функция фибоначчи(n):
    если n < 2 то:
        вернуть n
    конец
    вернуть фибоначчи(n - 1) + фибоначчи(n - 2)
конец

ряд = []
для i от 0 до 9 то:
    ряд.добавить(фибоначчи(i))
конец
вывести("Фибоначчи:", ряд)

# локальные переменные не утекают наружу,
# а глобальные можно менять из функции
счётчик = 0
функция увеличить():
    счётчик = счётчик + 1
конец
увеличить()
увеличить()
вывести("счётчик =", счётчик)

# словарь
человек = {"имя": "Аня", "возраст": 17}
вывести(человек["имя"], "-", человек["возраст"])
человек["город"] = "Тюмень"
вывести("ключи:", человек.ключи())
