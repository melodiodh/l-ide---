# ==========================================================
# Пример: графика и игра (аддоны создают отдельные окна)
#
# ВАЖНО: программу с окнами запускайте при включённом
# режиме «Запуск в главном потоке» (меню ☰ → Настройки),
# иначе окно аддона может не появиться.
# ==========================================================

включить mixday

# черепашья графика: квадрат
черепашка = mixday.СоздатьЧерепашку(600, 400, "#101418")
черепашка.Цвет("#58A6FF")
черепашка.Толщина(3)
для i от 1 до 4 то:
    черепашка.Вперед(100)
    черепашка.Вправо(90)
конец
вывести("Квадрат нарисован")

# простая игра: окно с игроком (WASD / стрелки)
игра = mixday.СоздатьИгру("L++ Game", 640, 480)
игра.СпавнВрага()
игра.СпавнВрага()
игра.Запустить()
вывести("Игра запущена: двигайтесь WASD")
